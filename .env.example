# Copy to .env and fill in. Never commit .env.

NODE_ENV=development
PORT=5000

# Local Postgres, or the Railway connection string
DATABASE_URL=postgres://postgres:postgres@localhost:5432/repairhub
# Set to true if the database requires SSL (some hosted databases do)
DATABASE_SSL=false

# At least 32 random characters. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Web origins allowed to call the API, comma separated. Mobile apps send no origin and are always allowed.
# Use * only for local testing.
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# Where the password reset link points (the web app page that handles the reset)
APP_URL=http://localhost:3000

# Email through Resend. Leave RESEND_API_KEY empty in development and the reset link is printed to the console.
RESEND_API_KEY=
EMAIL_FROM=RepairHub <onboarding@resend.dev>

# Login and reset attempts allowed per IP every 15 minutes. Raise it for a demo room that shares one IP.
AUTH_RATE_LIMIT=20

# Seed script
ADMIN_EMAIL=
ADMIN_PASSWORD=
SEED_DEMO=true
DEMO_PASSWORD=
